# PyPDF2 é uma biblioteca de manipulação de arquivos PDF feita em Python puro,","html":" \u003cspan class=pl-c\u003e# PyPDF2 é uma biblioteca de manipulação de arquivos PDF feita em Python puro,\u003c/span\u003e","displayNoNewLineWarning":false,"position":3,"left":2,"right":2},{"type":"CONTEXT","blobLineNumber":3,"text":" # gratuita e de código aberto. Ela é capaz de ler, manipular, escrever e unir","html":" \u003cspan class=pl-c\u003e# gratuita e de código aberto. Ela é capaz de ler, manipular, escrever e unir\u003c/span\u003e","displayNoNewLineWarning":false,"position":4,"left":3,"right":3},{"type":"CONTEXT","blobLineNumber":4,"text":" # dados de arquivos PDF, assim como adicionar anotações, transformar páginas,","html":" \u003cspan class=pl-c\u003e# dados de arquivos PDF, assim como adicionar anotações, transformar páginas,\u003c/span\u003e","displayNoNewLineWarning":false,"position":5,"left":4,"right":4},{"type":"HUNK","blobLineNumber":8,"text":"@@ -9,7 +9,7 @@","html":"@@ -9,7 +9,7 @@","displayNoNewLineWarning":false,"position":6,"left":8,"right":8},{"type":"CONTEXT","blobLineNumber":9,"text":" # pip install pypdf2","html":" \u003cspan class=pl-c\u003e# pip install pypdf2\u003c/span\u003e","displayNoNewLineWarning":false,"position":7,"left":9,"right":9},{"type":"CONTEXT","blobLineNumber":10,"text":" from pathlib import Path","html":" \u003cspan class=pl-k\u003efrom\u003c/span\u003e \u003cspan class=pl-s1\u003epathlib\u003c/span\u003e \u003cspan class=pl-k\u003eimport\u003c/span\u003e \u003cspan class=pl-v\u003ePath\u003c/span\u003e","displayNoNewLineWarning":false,"position":8,"left":10,"right":10},{"type":"CONTEXT","blobLineNumber":11,"text":" ","html":"\u003cbr\u003e","displayNoNewLineWarning":false,"position":9,"left":11,"right":11},{"type":"DELETION","blobLineNumber":12,"text":"-from PyPDF2 import PdfReader","html":"-\u003cspan class=\"pl-k\"\u003efrom\u003c/span\u003e \u003cspan class=\"pl-v\"\u003ePyPDF2\u003c/span\u003e \u003cspan class=\"pl-k\"\u003eimp